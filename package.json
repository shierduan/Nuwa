{
  "name": "nuwa-frontend",
  "version": "1.0.0",
  "description": "Nuwa Digital Life - Frontend and Manager",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "manager": "electron \"启动管理器.html\"",
    "debug": "electron debug.html",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "live2d",
    "electron",
    "digital-life",
    "nuwa",
    "manager"
  ],
  "author": "Nuwa Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.nuwa.frontend",
    "productName": "Nuwa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "main.js",
      "electron-main.js",
      "package.json",
      "启动管理器.html",
      "debug.html",
      "nuwa_main.py",
      "server_async.py",
      "manager.html"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "live2d-widget": "^3.1.4",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^5.3.3",
    "sweetalert2": "^11.7.20"
  }
}